<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="os-cordova-plugin-nos-widgets" version="0.3.0">

    <name>NOS Native Widgets</name>
    <description>Native home-screen widgets (Android Jetpack Glance / iOS WidgetKit) for OutSystems 11 mobile apps.</description>
    <license>MIT</license>
    <keywords>cordova,outsystems,android,ios,widget,glance,widgetkit</keywords>

    <engines>
        <engine name="cordova" version=">=12.0.0"/>
        <engine name="cordova-android" version=">=13.0.0"/>
        <engine name="cordova-ios" version=">=7.0.0"/>
    </engines>

    <js-module src="www/widget.js" name="nosWidgets">
        <clobbers target="cordova.plugins.nosWidgets"/>
    </js-module>

    <!-- ===================== CONFIGURABLE (OutSystems plugin variables) =====================
         Optional install variables, set per-app from the OutSystems Extensibility Configuration's
         plugin.variables, e.g.:
           "plugin": { "url": "...#<tag>",
                       "variables": [ { "name": "NOS_WIDGET_URL_SCHEME", "value": "pt.nos.myapp" } ] }
         EVERY variable has a non-empty default, so they are all OPTIONAL — an Android-only or a
         Simulator build needs none of them. The "__unset__" sentinel means "not configured": the iOS
         hook treats it as empty and falls back (Automatic signing / App Group derived from the bundle
         id). The values are surfaced into config.xml (see the iOS platform) where the after_prepare
         hook reads them. (A non-empty `default` is required, otherwise cordova makes the variable
         MANDATORY at install — hence the sentinel for the "unset" cases.)
         NOTE: the background-refresh interval is a RUNTIME setting via the JS configure({refreshMinutes})
         API, not a build variable. -->
    <preference name="NOS_WIDGET_URL_SCHEME" default="nosapp"/>
    <preference name="NOS_WIDGET_BUNDLE_SUFFIX" default="widget"/>
    <preference name="NOS_WIDGET_IOS_DEPLOYMENT_TARGET" default="14.0"/>
    <preference name="NOS_WIDGET_DISPLAY_NAME" default="NOS"/>
    <preference name="NOS_WIDGET_EXTENSION_NAME" default="NosWidgetExtension"/>
    <preference name="NOS_WIDGET_APP_GROUP" default="__unset__"/>
    <preference name="NOS_WIDGET_TEAM_ID" default="__unset__"/>
    <preference name="NOS_WIDGET_PROFILE_SPECIFIER" default="__unset__"/>
    <preference name="NOS_WIDGET_PROVISIONING_PROFILE" default="__unset__"/>

    <!-- ================================ ANDROID ================================ -->
    <platform name="android">

        <!-- Kotlin + Compose/Glance toolchain. Confirm versions against MABS 12.
             These must be injected into the app's config.xml: a bare <preference> in a
             plugin is treated by cordova as a REQUIRED install variable, not a build pref. -->
        <config-file target="config.xml" parent="/*">
            <preference name="GradlePluginKotlinEnabled" value="true"/>
            <preference name="GradlePluginKotlinCodeStyle" value="official"/>
            <preference name="GradlePluginKotlinVersion" value="1.9.24"/>
            <preference name="android-minSdkVersion" value="23"/>
            <preference name="android-compileSdkVersion" value="34"/>
            <preference name="android-targetSdkVersion" value="34"/>
        </config-file>

        <!-- Dependencies -->
        <framework src="androidx.glance:glance-appwidget:1.1.0"/>
        <framework src="androidx.work:work-runtime-ktx:2.9.1"/>
        <framework src="androidx.security:security-crypto:1.1.0-alpha06"/>
        <!-- Applies the Compose compiler to the app module so Glance @Composable code builds -->
        <framework src="src/android/nos-widgets.gradle" custom="true" type="gradleReference"/>

        <!-- Cordova service registration -->
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="NosWidgets">
                <param name="android-package" value="com.nos.widgets.NosWidgetPlugin"/>
            </feature>
        </config-file>

        <!-- Three Glance widget receivers: Saldo / Fatura / Consumos -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <receiver android:name="com.nos.widgets.glance.SaldoWidgetReceiver" android:exported="true">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                </intent-filter>
                <meta-data android:name="android.appwidget.provider" android:resource="@xml/nos_saldo_info"/>
            </receiver>
            <receiver android:name="com.nos.widgets.glance.FaturaWidgetReceiver" android:exported="true">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                </intent-filter>
                <meta-data android:name="android.appwidget.provider" android:resource="@xml/nos_fatura_info"/>
            </receiver>
            <receiver android:name="com.nos.widgets.glance.ConsumosWidgetReceiver" android:exported="true">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                </intent-filter>
                <meta-data android:name="android.appwidget.provider" android:resource="@xml/nos_consumos_info"/>
            </receiver>
        </config-file>

        <!-- Kotlin sources -->
        <source-file src="src/android/NosWidgetPlugin.kt" target-dir="app/src/main/java/com/nos/widgets"/>
        <source-file src="src/android/glance/NosWidgetCommon.kt" target-dir="app/src/main/java/com/nos/widgets/glance"/>
        <source-file src="src/android/glance/SaldoWidget.kt" target-dir="app/src/main/java/com/nos/widgets/glance"/>
        <source-file src="src/android/glance/FaturaWidget.kt" target-dir="app/src/main/java/com/nos/widgets/glance"/>
        <source-file src="src/android/glance/ConsumosWidget.kt" target-dir="app/src/main/java/com/nos/widgets/glance"/>
        <source-file src="src/android/work/RefreshWorker.kt" target-dir="app/src/main/java/com/nos/widgets/work"/>
        <source-file src="src/android/action/RefreshAction.kt" target-dir="app/src/main/java/com/nos/widgets/action"/>
        <source-file src="src/android/store/WidgetStore.kt" target-dir="app/src/main/java/com/nos/widgets/store"/>

        <!-- Widget metadata (NOT layout — Glance renders the UI in Kotlin) -->
        <resource-file src="res/android/xml/nos_saldo_info.xml" target="res/xml/nos_saldo_info.xml"/>
        <resource-file src="res/android/xml/nos_fatura_info.xml" target="res/xml/nos_fatura_info.xml"/>
        <resource-file src="res/android/xml/nos_consumos_info.xml" target="res/xml/nos_consumos_info.xml"/>
        <resource-file src="res/android/values/nos_widget_strings.xml" target="res/values/nos_widget_strings.xml"/>
        <resource-file src="res/android/drawable/nos_widget_preview.xml" target="res/drawable/nos_widget_preview.xml"/>
        <!-- NOS palette with system light/dark (values + values-night) -->
        <resource-file src="res/android/values/nos_colors.xml" target="res/values/nos_colors.xml"/>
        <resource-file src="res/android/values-night/nos_colors.xml" target="res/values-night/nos_colors.xml"/>
    </platform>

    <!-- ================================== iOS ================================== -->
    <platform name="ios">

        <config-file target="config.xml" parent="/*">
            <preference name="UseSwiftLanguageVersion" value="5"/>
        </config-file>

        <!-- Cordova bridge lives in the MAIN app target -->
        <config-file target="config.xml" parent="/*">
            <feature name="NosWidgets">
                <param name="ios-package" value="NosWidgetPlugin"/>
            </feature>
        </config-file>
        <source-file src="src/ios/NosWidgetPlugin.swift"/>

        <!-- App target uses WidgetCenter to reload the widget timeline -->
        <framework src="WidgetKit.framework" weak="true"/>

        <!-- Custom URL scheme for widget deep links -->
        <config-file target="*-Info.plist" parent="CFBundleURLTypes">
            <array>
                <dict>
                    <key>CFBundleURLSchemes</key>
                    <array>
                        <string>$NOS_WIDGET_URL_SCHEME</string>
                    </array>
                </dict>
            </array>
        </config-file>

        <!-- Surface the plugin variables into config.xml so the after_prepare hook can read them
             (cordova substitutes the $VARIABLE values here at plugin install time). -->
        <config-file target="config.xml" parent="/*">
            <preference name="NosWidgetUrlScheme" value="$NOS_WIDGET_URL_SCHEME"/>
            <preference name="NosWidgetBundleSuffix" value="$NOS_WIDGET_BUNDLE_SUFFIX"/>
            <preference name="NosWidgetIosDeploymentTarget" value="$NOS_WIDGET_IOS_DEPLOYMENT_TARGET"/>
            <preference name="NosWidgetDisplayName" value="$NOS_WIDGET_DISPLAY_NAME"/>
            <preference name="NosWidgetExtensionName" value="$NOS_WIDGET_EXTENSION_NAME"/>
            <preference name="NosWidgetAppGroup" value="$NOS_WIDGET_APP_GROUP"/>
            <preference name="NosWidgetTeamId" value="$NOS_WIDGET_TEAM_ID"/>
            <preference name="NosWidgetProfileSpecifier" value="$NOS_WIDGET_PROFILE_SPECIFIER"/>
            <preference name="NosWidgetProvisioningProfile" value="$NOS_WIDGET_PROVISIONING_PROFILE"/>
        </config-file>

        <!--
          The WidgetKit EXTENSION is a separate Xcode target. Cordova <source-file>
          cannot create a new target, so it is injected by the hook below, which:
            - creates the app-extension target + build phases
            - adds src/ios/widget/*.swift to that target
            - writes App Group entitlements to BOTH targets
            - sets the extension deployment target + signing (see hook header)
          Signing of this 2nd target under MABS is configurable via the variables above
          (NOS_WIDGET_TEAM_ID / NOS_WIDGET_PROFILE_SPECIFIER / NOS_WIDGET_PROVISIONING_PROFILE).
        -->
        <hook type="after_prepare" src="hooks/ios-add-widget-extension.js"/>
    </platform>
</plugin>
